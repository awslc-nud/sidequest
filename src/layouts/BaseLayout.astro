---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Body classes; defaults to the dark theme used by the marshal pages. */
  bodyClass?: string;
}

const {
  title,
  description = 'SideQuest',
  bodyClass = 'bg-zinc-950 text-zinc-100 antialiased [color-scheme:dark]',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
