# SideQuest environment — copy to `.env` and adjust for your machine/event.

# Prisma SQLite connection URL (used by `prisma migrate`/`prisma db push`).
# A plain absolute path is also accepted at runtime.
DATABASE_URL="file:./data/sidequest.db"

# Directory holding runtime uploads (relative to project root).
# Media lead is pointed at: <SIDEQUEST_DATA_DIR>/uploads/<event-slug>/
SIDEQUEST_DATA_DIR="./data"

# Shared static passphrase used by every marshal (event staff) to sign in.
# Generate once before the event, e.g. `openssl rand -base64 24`.
MARSHAL_SECRET_KEY="change-me-to-a-long-random-string"

# Server-side Upload Admission Queue tuning (§4.2b of spec.md).
UPLOAD_CONCURRENCY=4
UPLOAD_QUEUE_DEPTH=40

# Marshal auth cookie + attendee session cookie lifetime, in seconds
# (defaults to 12h). Tune to remaining event time before going live.
SESSION_MAX_AGE_SECONDS=43200

# Optional: Cloudflare Tunnel (consumed by the `cloudflared` compose service).
# When set, `docker compose --profile tunnel up` publishes the site from behind
# CGNAT without port-forwarding. Create a tunnel in the Cloudflare Zero Trust
# dashboard, set its public hostname's service to http://app:4321, then paste
# the tunnel token here. Leave blank to serve on the local network only.
CLOUDFLARE_TUNNEL_TOKEN=""
